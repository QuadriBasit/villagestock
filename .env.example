VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Dev only (npm run dev): simulate a paid plan without changing Supabase. Ignored in production builds.
# Values: trial | starter | pro | business
# VITE_DEBUG_BUSINESS_PLAN=pro

# Canonical public URL (no trailing path). Used in password-reset & signup confirmation links.
# Must match Supabase → Authentication → URL Configuration (Site URL / Redirect URLs).
# Local dev: use the origin Vite prints (e.g. http://localhost:5174 if 5173 was in use).
# VITE_PUBLIC_SITE_URL=http://localhost:5174
# Example production: https://your-app.vercel.app
# VITE_PUBLIC_SITE_URL=https://your-app.vercel.app

# Edge Function `invite-staff` (Supabase Dashboard → Edge Functions → Secrets):
# Set INVITE_PUBLIC_SITE_URL to the same origin as VITE_PUBLIC_SITE_URL so invite emails redirect to /auth correctly.
# Example local: INVITE_PUBLIC_SITE_URL=http://localhost:5174
